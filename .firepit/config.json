{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "sacrvm-desktop",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the desktop on port 3300 (also reachable from a phone on the LAN).",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "3300"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Open",
      "name": "local",
      "description": "The desktop on the local server.",
      "type": "url",
      "url": "http://localhost:3300/"
    },
    {
      "group": "Open",
      "name": "live",
      "description": "The live desktop at desktop.sacrvm.dev.",
      "type": "url",
      "url": "https://desktop.sacrvm.dev/"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "The repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/sacrvm-desktop"
    }
  ]
}
